# Site block for the game, on its own subdomain. Append it to the existing
# /etc/caddy/Caddyfile (the other project's blocks stay as they are).
bombe.duckdns.org {
	encode zstd gzip

	# Colyseus: HTTP matchmaking and the WebSocket upgrade both go through here.
	# handle_path strips /colyseus, so the server sees /matchmake/..., /health, /<process>/<room>.
	handle_path /colyseus/* {
		reverse_proxy 127.0.0.1:2567
	}

	# Static client build (client/dist copied to /opt/bombe/client/dist).
	handle {
		root * /opt/bombe/client/dist
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
