# Colyseus endpoint used by ColyseusTransport. A bare path means the page's own host
# (the default, "/colyseus": the Vite proxy in dev, Caddy in production).
# An absolute URL works too: wss://bombe.example.org/colyseus
# Empty = offline-only build ("Creează room" runs a local game with bots).
VITE_SERVER_URL=/colyseus
