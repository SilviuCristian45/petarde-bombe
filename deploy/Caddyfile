# Site block for Bombe și Petarde. Not a whole Caddyfile: deploy/setup.sh appends it to
# /etc/caddy/Caddyfile only if the domain is not there yet; the other sites stay untouched.
bombe-petarde.duckdns.org {
	encode zstd gzip

	# Colyseus: HTTP matchmaking and the WebSocket upgrade both go through here.
	# handle_path strips /colyseus, so the server sees /matchmake/..., /health, /<process>/<room>.
	handle_path /colyseus/* {
		reverse_proxy 127.0.0.1:2567
	}

	# The client build. /var/www/bombe -> /opt/bombe/current/client (switched atomically on deploy).
	handle {
		root * /var/www/bombe
		@index path / /index.html
		header @index Cache-Control "no-cache"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
