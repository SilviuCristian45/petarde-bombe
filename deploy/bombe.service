# systemd unit for the Bombe și Petarde game server, installed by deploy/setup.sh.
# /opt/bombe/current is a symlink to the active release (switched atomically by deploy/push.ps1).
[Unit]
Description=Bombe și Petarde (Colyseus)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bombe
Group=bombe
WorkingDirectory=/opt/bombe/current/server
ExecStart=/usr/bin/node /opt/bombe/current/server/index.js
Environment=NODE_ENV=production
Environment=PORT=2567
Environment=MAX_ROOMS=20
Restart=always
RestartSec=3

# Shared 1 GB VPS: keep the game in its own small box.
MemoryMax=300M
Environment=NODE_OPTIONS=--max-old-space-size=200

# Hardening: the process only reads its bundle and listens on loopback.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
